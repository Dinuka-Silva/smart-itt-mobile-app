# SMART ITT Backend Environment Configuration Example
# Copy this file to .env or configure these variables in your deployment environment

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_itt
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5

# Application & JWT Security
JWT_SECRET=your_base64_or_hex_encoded_256bit_secure_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
API_KEY=your_production_api_key_here
REQUIRE_API_KEY=false

# Container Photos Storage & Retention
UPLOAD_DIR=./uploads/photos
PHOTO_RETENTION_MONTHS=0

# Server
PORT=8080
