# ====================================================================
# SMART ITT - ENVIRONMENT SECURITY CONFIGURATION TEMPLATE
# Copy this file to .env and provide your production credentials.
# NEVER commit your actual .env file with secrets into version control!
# ====================================================================

# --- Security & API Keys ---
# Secure 256-bit+ JWT secret key for signing tokens
JWT_SECRET=replace-with-a-very-strong-secure-256-bit-secret-key-for-prod
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gateway / Application API Key
API_KEY=smart-itt-sec-key-prod-2026
REQUIRE_API_KEY=false

# --- Database Credentials ---
# PostgreSQL Production Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartitt
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
DB_POOL_MAX=20
DB_POOL_MIN=5

# --- Server Settings ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Frontend Settings ---
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_API_KEY=smart-itt-sec-key-prod-2026
